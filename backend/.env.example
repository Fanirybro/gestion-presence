DATABASE_URL=postgresql://postgres:password@localhost:5432/presence_saas
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Facultatif : clé stable dédiée aux badges (32 caractères minimum).
# Sans BADGE_SECRET, SESSION_SECRET est utilisée pour signer les badges.
# BADGE_SECRET=
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
# Seulement derrière un reverse proxy connu : nombre de relais de confiance.
# TRUST_PROXY_HOPS=1
